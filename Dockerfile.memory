# --- Builder Stage ---
FROM python:3.12-slim-bookworm as builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Create and activate a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- Final Stage ---
FROM python:3.12-slim-bookworm as final

# ตั้ง working directory
WORKDIR /app

# Create a non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# คัดลอกโค้ดทั้งหมดเข้า container
COPY --chown=appuser:appgroup . .

# Switch to the non-root user
USER appuser

# Ensure the venv is on the path
ENV PATH="/opt/venv/bin:$PATH"

# Healthcheck to ensure the service is running
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8081}/health || exit 1

# คำสั่งรัน Uvicorn โดยใช้ $PORT จาก environment variable
# The PORT environment variable is expected to be set by the orchestrator (e.g., Cloud Run, Docker Compose)
CMD ["sh", "-c", "uvicorn memory_service:app --host 0.0.0.0 --port ${PORT:-8081}"]
